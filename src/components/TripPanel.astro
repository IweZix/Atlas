---
import type { ImageMetadata } from 'astro';
import Photos from './Photos.astro';

interface Props {
  slug: string;
  name: string;
  year: number;
  caption: string;
  photos: ImageMetadata[];
  upcoming: boolean;
  coords: string;
  hidden: boolean;
}

const { slug, name, year, caption, photos, upcoming, coords, hidden } = Astro.props;
---

<article class="trip" data-slug={slug} hidden={hidden}>
  <header>
    <h2>{name}</h2>
    <span class="year mono">{upcoming ? `${year} · BIENTÔT` : year}</span>
  </header>
  <p class="caption">{caption}</p>
  {
    upcoming ? (
      <div class="soon">
        <span class="soon-label mono">PROCHAINE DESTINATION</span>
        <span class="soon-coords mono">{coords}</span>
      </div>
    ) : (
      <Photos photos={photos} tripName={name} />
    )
  }
</article>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 28px var(--gutter) 0;
  }

  h2 {
    margin: 0;
    font-size: 40px;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .year {
    font-size: 12px;
    color: var(--text-muted);
  }

  .caption {
    margin: 0;
    padding: 8px var(--gutter) 18px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .soon {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 80px;
    min-height: 220px;
    margin: 0 var(--gutter);
    padding: 16px;
    border: 1px dashed var(--chip-border);
    border-radius: var(--radius-photo);
    background: repeating-linear-gradient(
      135deg,
      transparent 0 8px,
      rgba(255, 255, 255, 0.015) 8px 16px
    );
  }

  .soon-label {
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .soon-coords {
    font-size: 10px;
    color: var(--text-faint);
  }

  @media (min-width: 900px) {
    header {
      padding-top: 40px;
    }

    h2 {
      font-size: 52px;
      line-height: 1;
      letter-spacing: -0.035em;
    }

    .caption {
      padding-top: 12px;
      padding-bottom: 22px;
      font-size: 15px;
      line-height: 1.5;
    }
  }
</style>
