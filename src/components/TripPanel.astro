---
import type { ImageMetadata } from 'astro';
import Photos from './Photos.astro';

interface Props {
  slug: string;
  name: string;
  year: number;
  caption: string;
  photos: ImageMetadata[];
  hidden: boolean;
}

const { slug, name, year, caption, photos, hidden } = Astro.props;
---

<article class="trip" data-slug={slug} hidden={hidden}>
  <header>
    <h2>{name}</h2>
    <span class="year mono">{year}</span>
  </header>
  <p class="caption">{caption}</p>
  <Photos photos={photos} tripName={name} />
</article>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 28px var(--gutter) 0;
  }

  h2 {
    margin: 0;
    font-size: 40px;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .year {
    font-size: 12px;
    color: var(--text-muted);
  }

  .caption {
    margin: 0;
    padding: 8px var(--gutter) 18px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  @media (min-width: 900px) {
    header {
      padding-top: 40px;
    }

    h2 {
      font-size: 52px;
      line-height: 1;
      letter-spacing: -0.035em;
    }

    .caption {
      padding-top: 12px;
      padding-bottom: 22px;
      font-size: 15px;
      line-height: 1.5;
    }
  }
</style>
