---
interface Props {
  years: string;
  coords: string;
  instagramUrl: string;
}

const { years, coords, instagramUrl } = Astro.props;
---

<section class="globe-pane">
  <canvas id="globe" aria-hidden="true"></canvas>
  <div class="top">
    <span class="handle">luca_ncl</span>
    <span class="tag mono">CARNET DE ROUTE · {years}</span>
    <a class="insta mono" href={instagramUrl} rel="noopener">INSTAGRAM ↗</a>
  </div>
  <div class="bottom mono">
    <span data-coords>{coords}</span>
    <span class="hint-mobile">← glisse · pince →</span>
    <span class="hint-desktop">Glisse pour tourner · molette pour zoomer · clique un point</span>
  </div>
</section>

<style>
  .globe-pane {
    position: relative;
    height: 470px;
    background: var(--bg);
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    touch-action: none;
    cursor: grab;
  }

  .top {
    position: absolute;
    top: 56px;
    left: var(--gutter);
    right: var(--gutter);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    pointer-events: none;
  }

  .handle {
    font-size: 17px;
    font-weight: 500;
  }

  .tag,
  .hint-desktop {
    display: none;
  }

  .insta {
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--text-chip);
    pointer-events: auto;
  }

  .bottom {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 16px;
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    color: var(--text-faint);
    pointer-events: none;
  }

  @media (min-width: 900px) {
    .globe-pane {
      height: auto;
      min-height: 0;
    }

    .top {
      top: 36px;
      left: 40px;
      right: auto;
      flex-direction: column;
      gap: 6px;
    }

    .handle {
      font-size: 20px;
      letter-spacing: -0.01em;
    }

    .tag {
      display: block;
      font-size: 11px;
      letter-spacing: 0.08em;
      color: var(--text-dim);
    }

    .insta {
      display: none;
    }

    .bottom {
      left: 40px;
      right: 40px;
      bottom: 28px;
      font-size: 11px;
    }

    .hint-mobile {
      display: none;
    }

    .hint-desktop {
      display: inline;
    }
  }
</style>
