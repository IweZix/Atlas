---
import type { ImageMetadata } from 'astro';
import { getImage, Picture } from 'astro:assets';

interface Props {
  photos: ImageMetadata[];
  tripName: string;
}

const { photos, tripName } = Astro.props;

const items = await Promise.all(
  photos.map(async (src, i) => ({
    src,
    alt: `${tripName} — photo ${i + 1}`,
    full: (await getImage({ src, width: 1600, format: 'webp' })).src,
  }))
);
---

<ul class="photos">
  {
    items.map((p) => (
      <li>
        <button type="button" class="photo" data-full={p.full} data-alt={p.alt} aria-label={`Agrandir : ${p.alt}`}>
          <Picture
            src={p.src}
            alt={p.alt}
            formats={['avif', 'webp']}
            widths={[260, 390, 520, 780]}
            sizes="(min-width: 900px) 200px, 260px"
            loading="lazy"
            decoding="async"
          />
        </button>
      </li>
    ))
  }
</ul>

<style>
  .photos {
    display: flex;
    gap: 6px;
    margin: 0;
    padding: 0 var(--gutter);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }

  li {
    flex: none;
    width: 260px;
    scroll-snap-align: center;
  }

  .photo {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-photo);
    overflow: hidden;
    background: repeating-linear-gradient(
      135deg,
      var(--placeholder-a) 0 8px,
      var(--placeholder-b) 8px 16px
    );
  }

  .photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 900px) {
    .photos {
      display: grid;
      grid-template-columns: 1fr 1fr;
      overflow: visible;
      scroll-snap-type: none;
    }

    li {
      width: auto;
    }
  }
</style>
