    background: transparent;
    color: var(--text);
  }

  dialog[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  dialog::backdrop {
    background: rgba(0, 0, 0, 0.94);
  }

  img {
    max-width: 100%;
    max-height: calc(100dvh - 96px);
    object-fit: contain;
    border-radius: var(--radius-photo);
  }

  .bar {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 28px;
    display: flex;
    align-items: baseline;
    gap: 18px;
    font-size: 12px;
    color: var(--text-chip);
  }

  .close {
    margin-left: auto;
    font-size: 11px;
    letter-spacing: 0.06em;
  }

  .bar button {
    color: inherit;
    font-family: inherit;
